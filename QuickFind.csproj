<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>QuickFind</AssemblyName>
    <RootNamespace>QuickFind</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>Jianmo-R and QuickFind contributors</Authors>
    <Company>Jianmo-R and QuickFind contributors</Company>
    <Product>闪查 QuickFind</Product>
    <Description>Windows 本机文件极速定位，支持文件名精确匹配与网页版 DeepSeek 相关词扩展。</Description>
    <Copyright>Copyright (c) 2026 Jianmo-R and QuickFind contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Jianmo-R/QuickFind</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Jianmo-R/QuickFind</PackageProjectUrl>
    <PackageTags>windows;winforms;file-search;deepseek;webview2;productivity</PackageTags>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" LogicalName="QuickFind.assets.app.ico" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
                      LogicalName="QuickFind.Native.WebView2Loader.dll"
                      Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="RemoveWebView2ExtrasFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Filename)' == 'WebView2Loader'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.xml' and
                                        ('%(ResolvedFileToPublish.Filename)' == 'Microsoft.Web.WebView2.Core' or
                                         '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Web.WebView2.WinForms' or
                                         '%(ResolvedFileToPublish.Filename)' == 'Microsoft.Web.WebView2.Wpf')" />
    </ItemGroup>
  </Target>
</Project>
